{
  "name": "@vcmach/adk-notes-capture-server",
  "version": "0.1.0",
  "description": "TypeScript WebSocket server for voice-enabled job intake and notes capture using Google Gemini Live API",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./streaming-service": {
      "types": "./dist/streaming-service.d.ts",
      "default": "./dist/streaming-service.js"
    },
    "./config": {
      "types": "./dist/config/env.d.ts",
      "default": "./dist/config/env.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "default": "./dist/database/index.js"
    },
    "./azure-blob-storage": {
      "types": "./dist/infrastructure/azure/azure-blob-storage.d.ts",
      "default": "./dist/infrastructure/azure/azure-blob-storage.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "check:deps": "dependency-cruise config --output-type err"
  },
  "keywords": [
    "websocket",
    "gemini",
    "voice",
    "job-intake",
    "notes-capture",
    "google-adk",
    "typescript",
    "realtime-audio"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/adk": "^0.3.0",
    "@google/genai": "^1.42.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
