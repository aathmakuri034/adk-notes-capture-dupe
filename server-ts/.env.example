# Google Cloud / Vertex AI Configuration
PROJECT_ID=your-project-id
LOCATION=us-central1

# Model Configuration
MODEL=gemini-live-2.5-flash-native-audio
EXTRACTION_MODEL=gemini-2.0-flash
VOICE_NAME=Aoede

# Authentication (choose one method)
# Option 1: API Key (for standard Gemini API - NOT supported for Live API)
# GOOGLE_API_KEY=your-api-key

# Option 2: Vertex AI (REQUIRED for Live API / real-time voice streaming)
# Set GOOGLE_APPLICATION_CREDENTIALS to your service account key file path
# OR run: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_API_KEY = TODO

# Server Configuration
JOB_SERVICE_PORT=8080
NOTES_SERVICE_PORT=8081

# Optional: Azure Blob Storage for job schemas and transcripts
# Automatically uploads extracted job data to Azure Blob Storage
# If not configured, the app will work with local storage only (graceful degradation)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol
AZURE_CONTAINER_NAME=TODO

# Google Cloud Storage (for video uploads to Gemini)
# Bucket will be auto-created as: {PROJECT_ID}-job-assistant-media
# Videos are uploaded and made publicly accessible (required for Gemini Live API)
# Gemini Live API requires public HTTPS URLs, not gs:// URIs
# Authentication uses Google Application Default Credentials
# Run: gcloud auth application-default login
# Note: Videos are made public to avoid signed URL signing issues with user credentials

# Standard Gemini API for Video Processing
# Uses REST API with inline base64 (no public bucket needed)
VIDEO_API_MODEL=gemini-2.0-flash
VIDEO_MAX_SIZE_MB=50
STANDARD_API_TIMEOUT_MS=60000
STANDARD_API_MAX_RETRIES=3
USE_STANDARD_API_FOR_VIDEO=true